{
  "engine_version": 19,
  "tick_hz": 60,
  "subframe_quantum": 0.1,
  "notes": [
    "Events in the same frame are consumed in stored order; they are not sorted by subframe.",
    "Before each key event, held horizontal processing and Fall(dt) advance from current subframe to event.subframe.",
    "After all events, the source frame counter advances, then held horizontal processing and Fall() consume the remainder 1-current_subframe."
  ],
  "vectors": [
    {
      "name": "rotate_then_harddrop",
      "events": [
        {"frame": 100, "subframe": 0.2, "type": "keydown", "key": "rotateCW"},
        {"frame": 100, "subframe": 0.7, "type": "keydown", "key": "hardDrop"}
      ],
      "timeline": [
        "advance shift+fall 0.2F",
        "rotate CW immediately",
        "advance shift+fall 0.5F",
        "hard drop immediately",
        "advance source frame",
        "finish remaining 0.3F (new piece may be sleeping / safelocked depending lock transition)"
      ]
    },
    {
      "name": "softdrop_midframe",
      "events": [
        {"frame": 200, "subframe": 0.4, "type": "keydown", "key": "softDrop"}
      ],
      "timeline": [
        "advance normal shift+gravity 0.4F",
        "set inputSoftdrop=true",
        "advance source frame",
        "finish 0.6F with soft-drop gravity active"
      ]
    },
    {
      "name": "softdrop_release_midframe",
      "precondition": "inputSoftdrop=true at frame start",
      "events": [
        {"frame": 300, "subframe": 0.6, "type": "keyup", "key": "softDrop"}
      ],
      "timeline": [
        "advance 0.6F using soft-drop gravity",
        "set inputSoftdrop=false",
        "advance source frame",
        "finish 0.4F using ordinary gravity"
      ]
    },
    {
      "name": "same_subframe_insertion_order",
      "events": [
        {"frame": 400, "subframe": 0.5, "type": "keydown", "key": "rotateCW"},
        {"frame": 400, "subframe": 0.5, "type": "keydown", "key": "moveLeft"}
      ],
      "timeline": [
        "advance 0.5F",
        "rotate immediately",
        "no time advance for second event",
        "activate left and attempt immediate shift on rotated geometry",
        "advance source frame",
        "finish 0.5F"
      ]
    },
    {
      "name": "decreasing_subframe_malformed_replay",
      "events": [
        {"frame": 500, "subframe": 0.8, "type": "keydown", "key": "rotateCW"},
        {"frame": 500, "subframe": 0.2, "type": "keydown", "key": "hardDrop"}
      ],
      "timeline": [
        "advance 0.8F",
        "rotate immediately",
        "second _ProcessSubframe sees 0.2 <= 0.8 and does not rewind",
        "hard drop executes at current 0.8F state",
        "advance source frame",
        "finish 0.2F"
      ]
    },
    {
      "name": "safelock_call_count_quirk",
      "precondition": "piece.safelock=7 at frame start",
      "events": [
        {"frame": 600, "subframe": 0.2, "type": "keydown", "key": "rotateCW"},
        {"frame": 600, "subframe": 0.4, "type": "keyup", "key": "rotateCW"},
        {"frame": 600, "subframe": 0.6, "type": "keydown", "key": "moveLeft"},
        {"frame": 600, "subframe": 0.8, "type": "keyup", "key": "moveLeft"}
      ],
      "expected_safelock_decrements": 5,
      "explanation": "Four positive subframe advances call Fall(dt), then the remaining-frame Fall() calls it once more. Safelock decrement is per Fall call, not proportional to dt."
    }
  ]
}
